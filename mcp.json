{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "openchase": {
      "type": "streamable-http",
      "url": "https://mcp.openchase.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["search", "offline_access"]
          }
        }
      }
    }
  }
}
